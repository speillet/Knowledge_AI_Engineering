root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Two spaces at the end of the line force a return to the line in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
